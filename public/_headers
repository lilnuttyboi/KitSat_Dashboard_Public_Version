# Security + caching headers. Read by Cloudflare Pages and Netlify (identical
# format). Vite copies this file from public/ to the site root (dist/_headers)
# at build time, so it ships automatically with `npm run build`.
#
# CSP note: the allowlist below matches exactly what the app loads —
#   • Supabase  (REST https + Realtime wss + camera Storage images): *.supabase.co
#   • Map tiles: CARTO (*.basemaps.cartocdn.com) + Esri (server.arcgisonline.com)
#   • 3D globe:  CesiumJS script/CSS/workers/WASM/assets from cesium.com
#   • Fonts:     Google Fonts (fonts.googleapis.com + fonts.gstatic.com)
# If you move Supabase to a custom domain, replace *.supabase.co with it.
# If the 3D map ever fails to load under CSP (console shows a CSP violation),
# add 'unsafe-eval' to script-src — some Cesium builds need it for WASM init.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' https://cesium.com; worker-src 'self' blob: https://cesium.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cesium.com; font-src 'self' data: https://fonts.gstatic.com https://cesium.com; img-src 'self' data: blob: https://*.supabase.co https://*.basemaps.cartocdn.com https://server.arcgisonline.com https://cesium.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.basemaps.cartocdn.com https://server.arcgisonline.com https://cesium.com; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# Vite fingerprints asset filenames, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
