# KitSat Dashboard — environment variables
# Copy this file to ".env" and fill in your own values.
# All variables must be prefixed with VITE_ so Vite exposes them to the client.

# Your Supabase project URL (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public API key (Project Settings → API → Project API keys → anon public)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Name of the table holding telemetry rows
VITE_SUPABASE_TABLE=your_table_name
